# Copy this file to .env and fill in real values. Never commit .env itself.

# Local MongoDB (requires `mongod` running on your machine):
# MONGODB_URI=mongodb://localhost:27017/products-app

# Or a MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers):
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/products-app?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=5000

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:3000

# Stripe secret key (test mode) — from https://dashboard.stripe.com/test/apikeys
# Card payments will fail with a 500 until this is set.
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Outgoing email (welcome, order confirmation/cancel/return, password reset).
# Leave all of these blank to use an auto-provisioned Ethereal test inbox —
# nothing is really delivered, but a preview link is logged to the server
# console for every email sent. Fill these in with real SMTP creds (e.g. a
# Gmail app password, or any provider's SMTP details) to send for real.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=ProductsApp <no-reply@productsapp.test>

# Optional: receives an internal notification whenever a customer submits a
# return/exchange request. Leave blank to skip that notification.
ADMIN_NOTIFY_EMAIL=
